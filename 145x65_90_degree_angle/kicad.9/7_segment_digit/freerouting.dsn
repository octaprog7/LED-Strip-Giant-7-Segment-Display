      (place LS2 125500.000000 -62000.000000 front 90.000000 (PN ~))
      (place LS3 125500.000000 -124000.000000 front 90.000000 (PN ~))
      (place LS6 72500.000000 -62000.000000 front 90.000000 (PN ~))
    )
    (component Resistor_SMD:R_0805_2012Metric
