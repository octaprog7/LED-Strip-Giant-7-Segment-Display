  (network
    (net /SEG_DP
      (pins X1-9 D1-1)
    )
    (net "Net-(D1-A)"
      (pins D1-2 R1-2)
    )
    (net /SEG_A
      (pins X1-2 LS1-2 LS1-4)
    )
    (net VCC
      (pins LS7-1 LS7-3 X1-1 LS4-1 LS4-3 LS5-1 LS5-3 LS2-1 LS2-3 LS3-1 LS3-3 LS6-1
        LS6-3 LS1-1 LS1-3 R1-1)
    )
    (net /SEG_B
      (pins X1-3 LS2-2 LS2-4)
    )
    (net /SEG_C
      (pins X1-4 LS3-2 LS3-4)
    )
    (net /SEG_D
      (pins X1-5 LS4-2 LS4-4)
    )
    (net /SEG_E
      (pins X1-6 LS5-2 LS5-4)
    )
    (net /SEG_F
      (pins X1-7 LS6-2 LS6-4)
    )
    (net /SEG_G
      (pins LS7-2 LS7-4 X1-8)
    )
    (net "unconnected-(X1-Pin_10-Pad10)"
      (pins X1-10)
    )
    (class kicad_default /SEG_A /SEG_B /SEG_C /SEG_D /SEG_DP /SEG_E /SEG_F
      /SEG_G "Net-(D1-A)" VCC "unconnected-(X1-Pin_10-Pad10)"
